{
  "schemaVersion": 1,
  "id": "sixsevenclient",
  "version": "1.6.2",
  "name": "WINTER CLIENT",
  "description": "WINTER CLIENT - Blue-to-white themed NanoVG ClickGUI and HUD for Minecraft 1.21.11.",
  "authors": [
    "WINTER CLIENT"
  ],
  "license": "All-Rights-Reserved",
  "icon": "assets/sixsevenclient/icon.png",
